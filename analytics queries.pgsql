{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect\r\n    t.instrument_key,\r\n    max(s.name),\r\n    count(t.instrument_key) as ct\r\nfrom\r\n    public.order_history t\r\njoin\r\n    public.stocks s \r\non\r\n    t.instrument_key=s.instrument_key\r\nwhere\r\n    user_id=20 \r\nGROUP BY\r\n    t.instrument_key \r\nORDER BY ct DESC\r\nLIMIT 3;\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- top profit money trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- delivery : equity investment distribution\r\n-- 1) get delivery open trades\r\nselect total_entry_value,ABS(total_entry_value+COALESCE(total_exit_value,0)) ,status from public.trade where user_id=20 and status='open' and trade_duration='delivery'  ;\r\n\r\n-- 2) get intraday vs equity % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' )\r\nselect \r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade \r\nwhere\r\n    user_id=20 and\r\n    status='open' \r\ngroup by\r\n    trade_duration  ;\r\n\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) get intraday distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='intraday' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='intraday'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n-- 2) get delivery distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='delivery' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='delivery'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) trader nature (buy more or sell more)\r\nwith sum_of_all as\r\n (select count(1) as total from public.order_history where user_id=20  )\r\n\r\nselect  \r\n    trade_type,\r\n    count(1),\r\n    ROUND((COUNT(1) * 100.0 / (SELECT total FROM sum_of_all))::numeric,2) AS perc\r\nfrom \r\n    public.order_history \r\nwhere\r\n    user_id=20\r\nGROUP BY trade_type;","kind":"sql","language":"sql"},{"value":"-- wins vs loss trade count-- pie chart\r\nwith sum_of_all as\r\n (select count(1) as total from public.trade where user_id=20 and status='settled'  )\r\n\r\nselect  \r\n    total_entry_value+COALESCE(total_exit_value,0)>0 profitable, -- profitable -true\r\n count(   total_entry_value+COALESCE(total_exit_value,0)>0 ),\r\n    (select * from sum_of_all)\r\n\r\nfrom \r\n    public.trade \r\nwhere\r\n    user_id=20\r\n    and status='settled' \r\nGROUP BY profitable;\r\n;","kind":"sql","language":"sql"},{"value":"-- your activity time (after market or in market)\r\nselect CASE when is_after_market_order=true then 'after market' else 'during' end, count(1) from public.order_history where user_id=20 GROUP BY is_after_market_order;\r\n\r\n","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect\r\n    t.instrument_key,\r\n    max(s.name),\r\n    count(t.instrument_key) as ct\r\nfrom\r\n    public.order_history t\r\njoin\r\n    public.stocks s \r\non\r\n    t.instrument_key=s.instrument_key\r\nwhere\r\n    user_id=20 \r\nGROUP BY\r\n    t.instrument_key \r\nORDER BY ct DESC\r\nLIMIT 3;\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- top profit money trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- delivery : equity investment distribution\r\n-- 1) get delivery open trades\r\nselect total_entry_value,ABS(total_entry_value+COALESCE(total_exit_value,0)) ,status from public.trade where user_id=20 and status='open' and trade_duration='delivery'  ;\r\n\r\n-- 2) get intraday vs equity % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' )\r\nselect \r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade \r\nwhere\r\n    user_id=20 and\r\n    status='open' \r\ngroup by\r\n    trade_duration  ;\r\n\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) get intraday distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='intraday' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='intraday'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n-- 2) get delivery distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='delivery' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='delivery'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) trader nature (buy more or sell more)\r\nwith sum_of_all as\r\n (select count(1) as total from public.order_history where user_id=20  )\r\n\r\nselect  \r\n    trade_type,\r\n    count(1),\r\n    ROUND((COUNT(1) * 100.0 / (SELECT total FROM sum_of_all))::numeric,2) AS perc\r\nfrom \r\n    public.order_history \r\nwhere\r\n    user_id=20\r\nGROUP BY trade_type;","kind":"sql","language":"sql"},{"value":"-- wins vs loss trade count-- pie chart\r\nwith sum_of_all as\r\n (select count(1) as total from public.trade where user_id=20 and status='settled'  )\r\n\r\nselect  \r\n    total_entry_value+COALESCE(total_exit_value,0)>0 profitable, -- profitable -true\r\n count(   total_entry_value+COALESCE(total_exit_value,0)>0 ),\r\n    (select * from sum_of_all)\r\n\r\nfrom \r\n    public.trade \r\nwhere\r\n    user_id=20\r\n    and status='settled' \r\nGROUP BY profitable;\r\n;","kind":"sql","language":"sql"},{"value":"-- your activity time (after market or in market)\r\nselect CASE when is_after_market_order=true then 'after market' else 'during' end, count(1) from public.order_history where user_id=20 GROUP BY is_after_market_order;\r\n\r\n","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"s