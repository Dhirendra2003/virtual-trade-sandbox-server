: `public.order_history`\n\n<div style=\"font-size: 12px; background-color: rgba(52, 152, 219, 0.1); border-left: 3px solid #3498db; padding: 6px 10px; margin-bottom: 15px; border-radius: 3px; color: var(--vscode-editor-foreground);\">\n    <strong>ℹ️ Note:</strong> Modify the query below to filter or transform the data as needed.\n</div>","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect t.instrument_key ,max(s.name) , count(t.instrument_key) as ct from public.order_history t join public.stocks s on t.instrument_key=s.instrument_key  where user_id=18 GROUP BY t.instrument_key ORDER BY ct DESC  LIMIT 3\r\n\r\n\r\n\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t