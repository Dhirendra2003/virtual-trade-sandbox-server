{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect\r\n    t.instrument_key,\r\n    max(s.name),\r\n    count(t.instrument_key) as ct\r\nfrom\r\n    public.order_history t\r\njoin\r\n    public.stocks s \r\non\r\n    t.instrument_key=s.instrument_key\r\nwhere\r\n    user_id=20 \r\nGROUP BY\r\n    t.instrument_key \r\nORDER BY ct DESC\r\nLIMIT 3;\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=18\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- top profit money trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"EXPLAIN (FORMAT JSON, ANALYZE, BUFFERS, VERBOSE) -- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total