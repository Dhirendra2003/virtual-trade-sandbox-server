key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n        GROUP BY t.instrument_key\r\n        ORDER BY trade_count DESC\r\n        LIMIT 3\r\n    )\r\n    SELECT json_build_object(\r\n\r\n        'most_traded', (SELECT json_agg(most_traded) FROM most_traded),\r\n\r\n        'top_profit_percent', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit_perc DESC LIMIT 3\r\n            ) t\r\n        ),\r\n\r\n        'top_profit_amount', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit DESC LIMIT 3\r\n            ) t\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_portfolio_distribution(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH base AS (\r\n        SELECT \r\n            t.instrument_key,\r\n            s.name,\r\n            t.trade_duration,\r\n            ABS(t.total_entry_value) AS invested\r\n        FROM public.trade t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n          AND t.status = 'open'\r\n          AND t.quantity > 0\r\n    ),\r\n\r\n    duration_split AS (\r\n        SELECT \r\n            trade_duration,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        GROUP BY trade_duration\r\n    ),\r\n\r\n    intraday AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'intraday'\r\n        GROUP BY instrument_key, name\r\n    ),\r\n\r\n    delivery AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'delivery'\r\n        GROUP BY instrument_key, name\r\n    )\r\n\r\n    SELECT json_build_object(\r\n\r\n        'duration_split', (\r\n            SELECT json_agg(duration_split) FROM duration_split\r\n        ),\r\n\r\n        'intraday_allocation', (\r\n            SELECT json_agg(intraday) FROM intraday\r\n        ),\r\n\r\n        'delivery_allocation', (\r\n            SELECT json_agg(delivery) FROM delivery\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"SELECT sp_pnl_analytics(20);\r\nSELECT sp_trade_insights(20);\r\nSELECT sp_portfolio_distribution(20);","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_consistency_heatmap(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            DATE(\"createdAt\") AS trade_date,\r\n            (total_exit_value + total_entry_value) AS profit\r\n        FROM public.trade\r\n        WHERE user_id = p_user_id\r\n          AND quantity = 0\r\n    ),\r\n\r\n    daily_stats AS (\r\n        SELECT\r\n            trade_date,\r\n            ROUND(SUM(profit), 2) AS total_profit,\r\n            COUNT(*) AS total_trades,\r\n            COUNT(*) FILTER (WHERE profit > 0) AS win_trades,\r\n            COUNT(*) FILTER (WHERE profit <= 0) AS loss_trades\r\n        FROM trades\r\n        GROUP BY trade_date\r\n        ORDER BY trade_date\r\n    )\r\n\r\n    SELECT json_build_object(\r\n        'heatmap', (\r\n            SELECT json_agg(daily_stats)\r\n            FROM daily_stats\r\n        )\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"SELECT sp_consistency_heatmap(20);","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"