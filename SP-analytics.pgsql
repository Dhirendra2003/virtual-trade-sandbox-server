1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### SP code\r\n\r\n","kind":"markdown","language":"markdown"},{"value":"CREATE OR REPLACE FUNCTION sp_pnl_analytics(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            id,\r\n            (total_exit_value + total_entry_value) AS profit,\r\n            ROUND((total_exit_value + total_entry_value)/ABS(total_entry_value)*100,2) AS profit_perc,\r\n            \"createdAt\"\r\n        FROM public.trade\r\n        WHERE user_id = p_user_id\r\n          AND quantity = 0\r\n    )\r\n    SELECT json_build_object(\r\n        'all_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades\r\n        ),\r\n        'profit_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades WHERE profit > 0\r\n        ),\r\n        'loss_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades WHERE profit <= 0\r\n        )\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_trade_insights(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            t.id,\r\n            t.instrument_key,\r\n            s.name,\r\n            (t.total_exit_value + t.total_entry_value) AS profit,\r\n            ROUND((t.total_exit_value + t.total_entry_value)/ABS(t.total_entry_value)*100,2) AS profit_perc\r\n        FROM public.trade t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n          AND t.quantity = 0\r\n    ),\r\n    most_traded AS (\r\n        SELECT\r\n            t.instrument_key,\r\n            MAX(s.name) AS name,\r\n            COUNT(*) AS trade_count\r\n        FROM public.order_history t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n        GROUP BY t.instrument_key\r\n        ORDER BY trade_count DESC\r\n        LIMIT 3\r\n    )\r\n    SELECT json_build_object(\r\n\r\n        'most_traded', (SELECT json_agg(most_traded) FROM most_traded),\r\n\r\n        'top_profit_percent', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit_perc DESC LIMIT 3\r\n            ) t\r\n        ),\r\n\r\n        'top_profit_amount', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit DESC LIMIT 3\r\n            ) t\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_portfolio_distribution(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH base AS (\r\n        SELECT \r\n            t.instrument_key,\r\n            s.name,\r\n            t.trade_duration,\r\n            ABS(t.total_entry_value) AS invested\r\n        FROM public.trade t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n          AND t.status = 'open'\r\n          AND t.quantity > 0\r\n    ),\r\n\r\n    duration_split AS (\r\n        SELECT \r\n            trade_duration,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        GROUP BY trade_duration\r\n    ),\r\n\r\n    intraday AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'intraday'\r\n        GROUP BY instrument_key, name\r\n    ),\r\n\r\n    delivery AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'delivery'\r\n        GROUP BY instrument_key, name\r\n    )\r\n\r\n    SELECT json_build_object(\r\n\r\n        'duration_split', (\r\n            SELECT json_agg(duration_split) FROM duration_split\r\n        ),\r\n\r\n        'intraday_allocation', (\r\n            SELECT json_agg(intraday) FROM intraday\r\n        ),\r\n\r\n        'delivery_allocation', (\r\n            SELECT json_agg(delivery) FROM delivery\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"SELECT sp_pnl_analytics(20);\r\nSELECT sp_trade_insights(20);\r\nSELECT sp_portfolio_distribution(20);","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_consistency_heatmap(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            DATE(\"createdAt\") AS trade_date,\r\n            (total_exit_value + total_entry_value) AS profit\r\n        FROM public.trade\r\n        WHERE user_id = p_user_id\r\n          AND quantity = 0\r\n    ),\r\n\r\n    daily_stats AS (\r\n        SELECT\r\n            trade_date,\r\n            ROUND(SUM(profit), 2) AS total_profit,\r\n            COUNT(*) AS total_trades,\r\n            COUNT(*) FILTER (WHERE profit > 0) AS win_trades,\r\n            COUNT(*) FILTER (WHERE profit <= 0) AS loss_trades\r\n        FROM trades\r\n        GROUP BY trade_date\r\n        ORDER BY trade_date\r\n    )\r\n\r\n    SELECT json_build_object(\r\n        'heatmap', (\r\n            SELECT json_agg(daily_stats)\r\n            FROM daily_stats\r\n        )\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"SELECT sp_consistency_heatmap(20);","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### SP code\r\n\r\n","kind":"markdown","language":"markdown"},{"value":"CREATE OR REPLACE FUNCTION sp_pnl_analytics(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            id,\r\n            (total_exit_value + total_entry_value) AS profit,\r\n            ROUND((total_exit_value + total_entry_value)/ABS(total_entry_value)*100,2) AS profit_perc,\r\n            \"createdAt\"\r\n        FROM public.trade\r\n        WHERE user_id = p_user_id\r\n          AND quantity = 0\r\n    )\r\n    SELECT json_build_object(\r\n        'all_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades\r\n        ),\r\n        'profit_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades WHERE profit > 0\r\n        ),\r\n        'loss_trades', (\r\n            SELECT json_agg(trades ORDER BY \"createdAt\") FROM trades WHERE profit <= 0\r\n        )\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_trade_insights(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH trades AS (\r\n        SELECT \r\n            t.id,\r\n            t.instrument_key,\r\n            s.name,\r\n            (t.total_exit_value + t.total_entry_value) AS profit,\r\n            ROUND((t.total_exit_value + t.total_entry_value)/ABS(t.total_entry_value)*100,2) AS profit_perc\r\n        FROM public.trade t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n          AND t.quantity = 0\r\n    ),\r\n    most_traded AS (\r\n        SELECT\r\n            t.instrument_key,\r\n            MAX(s.name) AS name,\r\n            COUNT(*) AS trade_count\r\n        FROM public.order_history t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n        GROUP BY t.instrument_key\r\n        ORDER BY trade_count DESC\r\n        LIMIT 3\r\n    )\r\n    SELECT json_build_object(\r\n\r\n        'most_traded', (SELECT json_agg(most_traded) FROM most_traded),\r\n\r\n        'top_profit_percent', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit_perc DESC LIMIT 3\r\n            ) t\r\n        ),\r\n\r\n        'top_profit_amount', (\r\n            SELECT json_agg(t) FROM (\r\n                SELECT * FROM trades ORDER BY profit DESC LIMIT 3\r\n            ) t\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"CREATE OR REPLACE FUNCTION sp_portfolio_distribution(p_user_id INT)\r\nRETURNS JSON AS $$\r\nDECLARE result JSON;\r\nBEGIN\r\n    WITH base AS (\r\n        SELECT \r\n            t.instrument_key,\r\n            s.name,\r\n            t.trade_duration,\r\n            ABS(t.total_entry_value) AS invested\r\n        FROM public.trade t\r\n        JOIN public.stocks s\r\n          ON t.instrument_key = s.instrument_key\r\n        WHERE t.user_id = p_user_id\r\n    ),\r\n\r\n    duration_split AS (\r\n        SELECT \r\n            trade_duration,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        GROUP BY trade_duration\r\n    ),\r\n\r\n    intraday AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'intraday'\r\n        GROUP BY instrument_key, name\r\n    ),\r\n\r\n    delivery AS (\r\n        SELECT \r\n            instrument_key,\r\n            name,\r\n            SUM(invested) AS total\r\n        FROM base\r\n        WHERE trade_duration = 'delivery'\r\n        GROUP BY instrument_key, name\r\n    )\r\n\r\n    SELECT json_build_object(\r\n\r\n        'duration_split', (\r\n            SELECT json_agg(duration_split) FROM duration_split\r\n        ),\r\n\r\n        'intraday_allocation', (\r\n            SELECT json_agg(intraday) FROM intraday\r\n        ),\r\n\r\n        'delivery_allocation', (\r\n            SELECT json_agg(delivery) FROM delivery\r\n        )\r\n\r\n    ) INTO result;\r\n\r\n    RETURN result;\r\nEND;\r\n$$ LANGUAGE plpgsql;","kind":"sql","language":"sql"},{"value":"SELECT sp_pnl_analytics(20);\r\nSELECT sp_trade_insights(20);\r\nSELECT sp_portfolio_distribution(20);","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect\r\n    t.instrument_key,\r\n    max(s.name),\r\n    count(t.instrument_key) as ct\r\nfrom\r\n    public.order_history t\r\njoin\r\n    public.stocks s \r\non\r\n    t.instrument_key=s.instrument_key\r\nwhere\r\n    user_id=20 \r\nGROUP BY\r\n    t.instrument_key \r\nORDER BY ct DESC\r\nLIMIT 3;\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- top profit money trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":" -- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- delivery : equity investment distribution\r\n-- 1) get delivery open trades\r\nselect total_entry_value,ABS(total_entry_value+COALESCE(total_exit_value,0)) ,status from public.trade where user_id=20 and status='open' and trade_duration='delivery'  ;\r\n\r\n-- 2) get intraday vs equity % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' )\r\nselect \r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade \r\nwhere\r\n    user_id=20 and\r\n    status='open' \r\ngroup by\r\n    trade_duration  ;\r\n\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) get intraday distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='intraday' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='intraday'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n-- 2) get delivery distribution  % -- PIE CHART\r\nwith sum_of_all as\r\n (select SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) from public.trade where user_id=20 and status='open' and trade_duration='delivery' )\r\nselect \r\n    t.instrument_key,\r\n    max(s.name),\r\n    trade_duration,\r\n    SUM(ABS(total_entry_value+COALESCE(total_exit_value,0))) as total_invested ,\r\n    ROUND(SUM(ABS(total_entry_value+COALESCE(total_exit_value,0)))/(select * from sum_of_all)*100,2) as total_inv_perc\r\nfrom\r\n    public.trade t \r\nJOIN\r\n    public.stocks s   \r\non t.instrument_key=s.instrument_key\r\nwhere\r\n    t.user_id=20 and\r\n    t.status='open' and\r\n    t.trade_duration='delivery'\r\ngroup by\r\n    t.instrument_key ,t.trade_duration  ;\r\n\r\n","kind":"sql","language":"sql"},{"value":"-- 1) trader nature (buy more or sell more)\r\nwith sum_of_all as\r\n (select count(1) as total from public.order_history where user_id=20  )\r\n\r\nselect  \r\n    trade_type,\r\n    count(1),\r\n    ROUND((COUNT(1) * 100.0 / (SELECT total FROM sum_of_all))::numeric,2) AS perc\r\nfrom \r\n    public.order_history \r\nwhere\r\n    user_id=20\r\nGROUP BY trade_type;","kind":"sql","language":"sql"},{"value":"-- wins vs loss trade count-- pie chart\r\nwith sum_of_all as\r\n (select count(1) as total from public.trade where user_id=20 and status='settled'  )\r\n\r\nselect  \r\n    total_entry_value+COALESCE(total_exit_value,0)>0 profitable, -- profitable -true\r\n count(   total_entry_value+COALESCE(total_exit_value,0)>0 ),\r\n    (select * from sum_of_all)\r\n\r\nfrom \r\n    public.trade \r\nwhere\r\n    user_id=20\r\n    and status='settled' \r\nGROUP BY profitable;\r\n;","kind":"sql","language":"sql"},{"value":"-- your activity time (after market or in market)\r\nselect CASE when is_after_market_order=true then 'after market' else 'during' end, count(1) from public.order_history where user_id=20 GROUP BY is_after_market_order;\r\n\r\n","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cells":[{"value":"### ANALYTICAL QUERIES: \n","kind":"markdown","language":"markdown"},{"value":"##### 📖 Query Data","kind":"markdown","language":"markdown"},{"value":"select \n  id,\n  total_exit_value+total_entry_value as profit,\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\nfrom\n\tpublic.trade \nwhere\n\tuser_id=20\n\tand quantity=0 \n\tand (total_exit_value+total_entry_value)<=0 -- loss trades\norder by\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0 \r\n\tand (total_exit_value+total_entry_value)>0 -- profit trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"select \r\n  id,\r\n  total_exit_value+total_entry_value as profit,\r\n ROUND((total_exit_value+total_entry_value)/ABS(total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade \r\nwhere\r\n\tuser_id=20\r\n\tand quantity=0  -- all trades\r\norder by\r\n\t\"createdAt\" ;","kind":"sql","language":"sql"},{"value":"-- your top  3 traded stock \r\nselect\r\n    t.instrument_key,\r\n    max(s.name),\r\n    count(t.instrument_key) as ct\r\nfrom\r\n    public.order_history t\r\njoin\r\n    public.stocks s \r\non\r\n    t.instrument_key=s.instrument_key\r\nwhere\r\n    user_id=20 \r\nGROUP BY\r\n    t.instrument_key \r\nORDER BY ct DESC\r\nLIMIT 3;\r\n","kind":"sql","language":"sql"},{"value":"-- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=18\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"-- top profit money trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"},{"value":"EXPLAIN (FORMAT JSON, ANALYZE, BUFFERS, VERBOSE) -- top profit percent trade\r\nselect \r\n  t.id,\r\n  t.instrument_key,\r\n  s.name,\r\n  t.total_exit_value+t.total_entry_value as profit,\r\n ROUND((t.total_exit_value+t.total_entry_value)/ABS(t.total_entry_value)*100,2) as profit_perc\r\nfrom\r\n\tpublic.trade t\r\njoin \r\n  public.stocks s\r\non\r\n  t.instrument_key=s.instrument_key\r\nwhere\r\n\tt.user_id=20\r\n\tand t.quantity=0  -- all trades\r\norder by\r\n\t\"profit_perc\" DESC \r\nLIMIT 3\r\n  ;","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1775153462972","databaseName":"postgres","host":"aws-1-ap-southeast-1.pooler.supabase.com","port":5432,"username":"postgres.uoiqbohcsgomuplwdzkf","password":"JY$-D!@bcyX9SM4","custom":{"cel